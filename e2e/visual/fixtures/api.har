            "text": "{\"templates\":[{\"key\":\"military\",\"name\":\"Military aircraft\",\"description\":\"Any aircraft classified as military (SPEC §39).\",\"severity\":\"high\",\"builtin\":false,\"conditions\":{\"version\":2,\"classification\":{\"military\":true,\"government\":false,\"law_enforcement\":false},\"watchlist_any\":false,\"applies_on_ground\":false}},{\"key\":\"government\",\"name\":\"Government aircraft\",\"description\":\"Any aircraft classified as a government operator.\",\"severity\":\"high\",\"builtin\":false,\"conditions\":{\"version\":2,\"classification\":{\"military\":false,\"government\":true,\"law_enforcement\":false},\"watchlist_any\":false,\"applies_on_ground\":false}},{\"key\":\"police\",\"name\":\"Police and law enforcement\",\"description\":\"Any aircraft classified as law enforcement (SPEC §39).\",\"severity\":\"high\",\"builtin\":false,\"conditions\":{\"version\":2,\"classification\":{\"military\":false,\"government\":false,\"law_enforcement\":true},\"watchlist_any\":false,\"applies_on_ground\":false}},{\"key\":\"emergency_squawk\",\"name\":\"Emergency squawk\",\"description\":\"Squawk 7500, 7600 or 7700. Built in and always on: SPEC §47 requires emergency squawks to alert without a rule, so this template has no rule to enable or disable.\",\"severity\":\"critical\",\"builtin\":true,\"conditions\":null},{\"key\":\"first_ever\",\"name\":\"First-ever aircraft\",\"description\":\"An airframe this receiver has never recorded before (SPEC §44).\",\"severity\":\"info\",\"builtin\":false,\"conditions\":{\"version\":2,\"watchlist_any\":false,\"rare_aircraft\":{\"max_sightings\":1},\"applies_on_ground\":false}},{\"key\":\"locally_rare\",\"name\":\"Locally rare aircraft\",\"description\":\"An airframe recorded at most 2 times here, this sighting included (SPEC §44).\",\"severity\":\"interesting\",\"builtin\":false,\"conditions\":{\"version\":2,\"watchlist_any\":false,\"rare_aircraft\":{\"max_sightings\":2},\"applies_on_ground\":false}},{\"key\"