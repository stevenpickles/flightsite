# Normalize all text files to LF in the repository and working tree.
# FlightSite targets Linux containers; Windows dev checkouts use LF too.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.gz binary
*.zip binary
*.sqlite3 binary

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
