# Build context excludes for frontend/Dockerfile.
# Keep the build context to exactly what the image needs: package.json,
# package-lock.json, and the app source. Everything else here would
# otherwise bust Docker's layer cache or leak local/dev-only state into the
# build context.

# Version control / CI
.git/
.github/

# Node
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo
*.local

# Tests (not needed to build or run the image)
src/test/
**/*.test.ts
**/*.test.tsx
**/__tests__/
playwright-report/
test-results/
blob-report/

# Local data / secrets (never belongs in an image layer)
data/
.env
.env.*

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Docker
Dockerfile
.dockerignore
